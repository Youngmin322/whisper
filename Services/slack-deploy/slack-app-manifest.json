{
  "display_information": {
    "name": "Whisper Deploy",
    "description": "Whisper TestFlight 배포와 App Store 심사 제출"
  },
  "features": {
    "slash_commands": [
      {
        "command": "/testflight",
        "url": "https://YOUR-WORKER.workers.dev/slack/commands",
        "description": "Whisper 내부 TestFlight 빌드 배포",
        "usage_hint": "[dev|main] 또는 help",
        "should_escape": false
      },
      {
        "command": "/review",
        "url": "https://YOUR-WORKER.workers.dev/slack/commands",
        "description": "기존 Whisper 빌드를 App Store 심사에 제출",
        "usage_hint": "버전 빌드번호 또는 help",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": { "bot": ["commands", "incoming-webhook"] }
  },
  "settings": { "org_deploy_enabled": false, "socket_mode_enabled": false }
}
